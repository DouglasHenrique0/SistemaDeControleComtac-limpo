@page "/Conta/Cadastrar"
@model SistemaDeControleComtac.Pages.Conta.CadastrarModel
@{
    ViewData["Title"] = "Cadastrar colaborador";
}

<div class="vehicle-form-page account-form-page">
    <div class="form-heading">
        <p class="form-kicker">Gestão de acesso</p>
        <h1>Cadastro de colaborador</h1>
        <p class="form-intro">Crie um acesso individual para manter a operação segura e rastreável.</p>
    </div>
    <form method="post">
    <div class="mb-3">
        <label asp-for="NovoUsuario.Nome" class="form-label"></label>
        <input asp-for="NovoUsuario.Nome" class="form-control" />
        <span asp-validation-for="NovoUsuario.Nome" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="NovoUsuario.Email" class="form-label"></label>
        <input asp-for="NovoUsuario.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="NovoUsuario.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Senha" class="form-label"></label>
        <input asp-for="Senha" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Senha" class="text-danger"></span>
    </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Cadastrar colaborador</button>
        </div>
    </form>
</div>
