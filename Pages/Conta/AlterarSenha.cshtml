@page
@model SistemaDeControleComtac.Pages.Conta.AlterarSenhaModel
@{
    ViewData["Title"] = "Alterar senha";
}

<div class="vehicle-form-page">
    <div class="form-heading">
        <p class="form-kicker">Segurança da conta</p>
        <h1>Alterar senha</h1>
        <p class="form-intro">Use uma senha nova e exclusiva para este sistema.</p>
    </div>

    <form method="post">
        <div class="mb-3">
            <label asp-for="SenhaAtual" class="form-label"></label>
            <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="SenhaAtual" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NovaSenha" class="form-label"></label>
            <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NovaSenha" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmacaoNovaSenha" class="form-label"></label>
            <input asp-for="ConfirmacaoNovaSenha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmacaoNovaSenha" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar nova senha</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
