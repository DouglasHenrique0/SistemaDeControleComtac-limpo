{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "OpenTelemetry": {
    "Otlp": {
      "Enabled": false
    }
  },

  "Sentry": {
    "TracesSampleRate": 0.1
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 300
    }
  },

  "AllowedHosts": "*"
}
