# Copie este arquivo para .env (no mesmo diretório do docker-compose.yml) e preencha.
# O .env está no .gitignore e no .dockerignore: ele nunca vai para o Git nem para a imagem.
#
#   cp .env.example .env
#
# Senha do usuário sa do SQL Server. É usada pelo container sql-comtac e pela
# connection string da aplicação. Não use aspas.
SA_PASSWORD=troque-por-uma-senha-forte
