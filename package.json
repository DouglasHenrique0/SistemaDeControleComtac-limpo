{
  "name": "sistema-de-controle-comtac-quality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "arch:check": "arch-contract check --format table",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "knip": "knip",
    "lint": "biome check . && tsc --noEmit",
    "quality": "pnpm lint && pnpm knip && pnpm arch:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.1.0",
    "@playwright/test": "1.62.1",
    "arch-contract": "0.3.0",
    "knip": "6.32.3",
    "typescript": "7.0.2"
  }
}
